# ──────────────────────────────────────────────────────────────
# Sounds & Fog – Customer Feedback System
# انسخ هذا الملف إلى .env ثم عدّل القيم قبل النشر
# Copy this file to .env and edit the values before deploying
# ──────────────────────────────────────────────────────────────

# المنفذ الذي يعمل عليه التطبيق / HTTP port
PORT=3000
HOST=0.0.0.0

# بيئة التشغيل: development | production
NODE_ENV=development

# العنوان العام للنظام (يُستخدم لتوليد رمز QR وروابط المشاركة)
# Public base URL – used for the QR code and share links
PUBLIC_BASE_URL=http://localhost:3000

# ── قاعدة البيانات / Database ────────────────────────────────
# مسار ملف SQLite. استخدم مسارًا على قرص دائم عند النشر.
# Path to the SQLite file. Use a persistent volume in production.
DATABASE_PATH=./data/feedback.db

# ── الأمان / Security ────────────────────────────────────────
# مفتاح سري لتوقيع الجلسات وتعمية البيانات الحساسة (32 حرفًا على الأقل)
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-please-to-a-long-random-string

# مدة الجلسة بالساعات / Session lifetime in hours
SESSION_TTL_HOURS=12

# اضبطها على 1 عند التشغيل خلف HTTPS / set to 1 when served over HTTPS
COOKIE_SECURE=0

# ── الحساب الإداري الأول / Bootstrap admin ───────────────────
# يُنشأ تلقائيًا عند أول تشغيل إذا لم يوجد أي مستخدم
ADMIN_EMAIL=admin@soundsandfog.sa
ADMIN_PASSWORD=ChangeMe#2026
ADMIN_NAME=مدير النظام

# ── منع التكرار / Anti-duplicate submissions ─────────────────
# أقل مدة بالدقائق بين إرسالين من نفس الجهاز
SUBMISSION_COOLDOWN_MINUTES=10
# أقصى عدد إرسالات لكل عنوان IP في الساعة
SUBMISSIONS_PER_IP_PER_HOUR=12

# ── النسخ الاحتياطي / Backups ────────────────────────────────
BACKUP_DIR=./data/backups
# نسخة احتياطية تلقائية كل X ساعة (0 = تعطيل)
AUTO_BACKUP_EVERY_HOURS=24
# عدد النسخ المحفوظة
BACKUP_KEEP=14

# اسم الفرع الافتراضي / Default branch label
DEFAULT_BRANCH_NAME=Sounds & Fog – الرياض
